direction: right

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 18
    center: true
  }
}

classes: {
  actor: {
    style: {
      fill: "#ffffff"
      stroke: "#333333"
      stroke-width: 2
      font-color: "#000000"
      font-size: 19
      bold: false
      border-radius: 0
      shadow: false
    }
  }
  artefact: {
    style: {
      fill: "#f7f7f7"
      stroke: "#555555"
      stroke-width: 2
      font-color: "#000000"
      font-size: 17
      bold: false
      border-radius: 0
      shadow: false
    }
  }
  holder: {
    style: {
      fill: "#ffffff"
      stroke: "#777777"
      stroke-width: 1
      font-color: "#000000"
      font-size: 16
      bold: false
      border-radius: 0
      shadow: false
    }
  }
  annotation: {
    shape: rectangle
    width: 230
    height: 38
    style: {
      fill: transparent
      stroke: transparent
      font-color: "#333333"
      font-size: 17
      bold: false
      italic: true
    }
  }
}

outgoing: {
  label: "Outgoing agent\nAccumulated context"
  class: actor
  width: 250
  height: 92
  style.fill: "#f7f7f7"
}

memory: {
  label: Memory
  class: holder

  handoff_log: {
    label: Handoff Log
    class: artefact
    width: 185
    height: 62
  }
}

message_bus: {
  label: Message Bus
  class: holder

  handoff_bus: {
    label: Handoff Bus
    class: artefact
    width: 185
    height: 62
  }
}

project_state: {
  label: "Other relevant\nproject state"
  class: artefact
  width: 210
  height: 84
}

incoming: {
  label: "Incoming agent\nFresh context"
  class: actor
  width: 250
  height: 92
}

mediation: {
  label: User mediates transfer
  class: annotation
  width: 230
  height: 38
  near: top-center
}

outgoing -> memory.handoff_log: " records " {
  style: {
    stroke: "#333333"
    stroke-width: 2
    font-color: "#000000"
    font-size: 16
    border-radius: 10
  }
}

memory.handoff_log -> incoming: " read by " {
  style: {
    stroke: "#333333"
    stroke-width: 2
    font-color: "#000000"
    font-size: 16
    border-radius: 10
  }
}

outgoing -> message_bus.handoff_bus: " writes " {
  style: {
    stroke: "#333333"
    stroke-width: 2
    font-color: "#000000"
    font-size: 16
    border-radius: 10
  }
}

message_bus.handoff_bus -> incoming: " read by " {
  style: {
    stroke: "#333333"
    stroke-width: 2
    font-color: "#000000"
    font-size: 16
    border-radius: 10
  }
}

project_state -> incoming: " read by " {
  style: {
    stroke: "#333333"
    stroke-width: 2
    font-color: "#000000"
    font-size: 16
    border-radius: 10
  }
}
