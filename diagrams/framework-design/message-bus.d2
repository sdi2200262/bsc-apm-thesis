direction: right

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 18
    center: true
  }
}

classes: {
  actor: {
    style: {
      fill: "#ffffff"
      stroke: "#333333"
      stroke-width: 2
      font-color: "#000000"
      font-size: 19
      bold: false
      border-radius: 0
      shadow: false
    }
  }
  artefact: {
    style: {
      fill: "#f7f7f7"
      stroke: "#555555"
      stroke-width: 2
      font-color: "#000000"
      font-size: 17
      bold: false
      border-radius: 0
      shadow: false
    }
  }
  holder: {
    style: {
      fill: "#ffffff"
      stroke: "#777777"
      stroke-width: 1
      font-color: "#000000"
      font-size: 16
      bold: false
      border-radius: 0
      shadow: false
    }
  }
  annotation: {
    shape: rectangle
    width: 230
    height: 38
    style: {
      fill: transparent
      stroke: transparent
      font-color: "#333333"
      font-size: 17
      bold: false
      italic: true
    }
  }
}

manager: {
  label: Manager
  class: actor
  width: 150
  height: 70
}

message_bus: {
  label: Message Bus
  class: holder

  task: {
    label: Task Bus
    class: artefact
    width: 175
    height: 62
  }

  report: {
    label: Report Bus
    class: artefact
    width: 175
    height: 62
  }
}

workers: {
  label: Workers
  class: actor
  width: 150
  height: 70
  style.multiple: true
}

mediation: {
  label: User mediates exchange
  class: annotation
  width: 230
  height: 38
  near: bottom-center
}

manager -> message_bus.task: " writes " {
  style: {
    stroke: "#333333"
    stroke-width: 2
    font-color: "#000000"
    font-size: 16
    border-radius: 10
  }
}

message_bus.task -> workers: " read by " {
  style: {
    stroke: "#333333"
    stroke-width: 2
    font-color: "#000000"
    font-size: 16
    border-radius: 10
  }
}

message_bus.report <-> workers: " writes " {
  source-arrowhead.shape: triangle
  target-arrowhead.shape: none
  style: {
    stroke: "#333333"
    stroke-width: 2
    font-color: "#000000"
    font-size: 16
    border-radius: 10
  }
}

manager <-> message_bus.report: " read by " {
  source-arrowhead.shape: triangle
  target-arrowhead.shape: none
  style: {
    stroke: "#333333"
    stroke-width: 2
    font-color: "#000000"
    font-size: 16
    border-radius: 10
  }
}
